{
  "name": "prism-soundboard",
  "productName": "Prism Soundboard",
  "description": "Professional Windows Gaming & Streaming Soundboard with Virtual Microphone & Global Hotkeys",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev": "concurrently -k \"vite\" \"wait-on http-get://localhost:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 node electron/starter.cjs\"",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "start": "node electron/starter.cjs"
  },
  "build": {
    "appId": "com.prism.soundboard",
    "productName": "Prism Soundboard",
    "publish": {
      "provider": "github",
      "owner": "fafaidot",
      "repo": "Prism-Soundboard"
    },
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prism Soundboard"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "fix-webm-duration": "^1.0.6",
    "lucide-react": "^1.61.0",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
